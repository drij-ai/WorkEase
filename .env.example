# ============================================================
# WorkEase Environment Configuration Example
# Copy this file to .env for local development with custom values.
# NEVER commit real production secrets to version control.
# ============================================================

# Django Secret Key (Generate a secure unique key for production)
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-random-key-64chars

# Debug mode (set to False in production)
DJANGO_DEBUG=False

# Hostnames allowed to connect (comma-separated list)
# Render automatically injects RENDER_EXTERNAL_HOSTNAME into ALLOWED_HOSTS
ALLOWED_HOSTS=localhost,127.0.0.1,workease.onrender.com

# CSRF Trusted Origins (comma-separated list, required for HTTPS POST requests)
CSRF_TRUSTED_ORIGINS=https://workease.onrender.com

# Database Connection URL (PostgreSQL on Render/Railway/Neon)
# If omitted or empty, Django falls back to local SQLite (db.sqlite3)
DATABASE_URL=postgresql://workease_user:password@hostname:5432/workease_db

# Web Server Port (Render injects PORT automatically)
PORT=8000

# HTTPS / Security Settings (Enabled by default when DJANGO_DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ============================================================
# Email Notification Configuration (SMTP)
# ============================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=WorkEase HR <noreply@workease.com>

# ============================================================
# Default Gateway API Configuration (Payroll & Salary Processing)
# Supported providers: razorpay (default), stripe, cashfree
# ============================================================
DEFAULT_GATEWAY_API=razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_optional_webhook_secret_here
PAYMENT_GATEWAY_CURRENCY=INR
